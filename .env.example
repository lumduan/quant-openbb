# =============================================================================
# quant-openbb runtime configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored; only .env.example is tracked in version control.
#
# This file is read by QuantOpenBBSettings (src/openbb_quant/config.py), a
# Pydantic Settings v2 model with env_prefix="QUANT_OPENBB_". Every variable
# below maps to a field on that model. Unknown env vars are silently ignored
# (extra="ignore"), so typos in var names won't cause startup errors — they'll
# just fall back to the default silently.
#
# The settings are consumed by three layers:
#   1. main.py        — FastAPI app bootstrap (CORS, logging, auth dependency)
#   2. router.py      — GatewayClient instantiation (base URL, API key for
#                       outbound calls to quant-api-gateway)
#   3. auth.py        — inbound X-API-Key verification on /api/v2/* endpoints
#
# ─── OpenBB Dashboard Integration ───────────────────────────────────────────
# The quant-openbb Docker image runs `uvicorn openbb_quant.main:app` which is
# a STANDALONE FastAPI app (NOT the full OpenBB Platform). This means:
#   - The 16 proxy endpoints under /api/v2/engines/* are available
#   - /health is available for liveness probes
#   - The OpenBB Dashboard (built-in web UI) is NOT available in this mode
#
# To use the OpenBB Dashboard (full Platform with built-in web UI), you would
# need to run the OpenBB Platform server instead, which auto-discovers the
# openbb_quant extension via the entry-point in pyproject.toml:
#
#   openbb --api --host 0.0.0.0 --port 8500
#
# This would:
#   - Mount the quant proxy router at /api/v2/engines/* (same as now)
#   - Expose the OpenBB REST API at /api/v1/*
#   - Serve the OpenBB Dashboard web UI for data exploration
#   - Auto-discover any other installed OpenBB extensions
#
# When running the full OpenBB Platform, you would also set these OpenBB-native
# env vars (NOT prefixed with QUANT_OPENBB_):
#   OPENBB_API_HOST=0.0.0.0
#   OPENBB_API_PORT=8500
#   OPENBB_API_USERNAME=admin        # Dashboard login
#   OPENBB_API_PASSWORD=yourpassword # Dashboard login
#   OPENBB_DEV_MODE=true             # Enable hot-reload in development
# =============================================================================


# ─── Gateway Base URL ───────────────────────────────────────────────────────
#
# QUANT_OPENBB_GATEWAY_BASE_URL
#
# The base URL of the quant-api-gateway's v2 engine surface. Every proxy
# endpoint in router.py strips its /api/v2 prefix and appends the remainder
# to this URL. For example, a request to /api/v2/engines/catalog becomes
# GET <gateway_base_url>/engines/catalog.
#
# Docker (production / default):
#   http://quant-api-gateway:8000/api/v2
#   This uses the Docker DNS hostname on quant-network. The gateway container
#   is reachable as "quant-api-gateway" because both containers join the same
#   Docker network. Port 8000 is the CONTAINER port, not the host port (which
#   is 8080 per your docker-compose).
#
# Host-side debugging (when running `uv run uvicorn openbb_quant.main:app`
# directly on your machine, outside Docker):
#   http://localhost:8080/api/v2
#   Because the gateway's host port mapping is 8080:8000.
#
# IMPORTANT: Do NOT include a trailing slash. The client strips it anyway,
# but keeping the convention clean avoids confusion.
#
QUANT_OPENBB_GATEWAY_BASE_URL=http://quant-api-gateway:8000/api/v2


# ─── Internal API Key ───────────────────────────────────────────────────────
#
# QUANT_OPENBB_INTERNAL_API_KEY
#
# This single key serves TWO purposes (dual-use):
#
#   A) OUTBOUND (proxy → gateway):
#      Injected as the X-API-Key header on every request from quant-openbb to
#      quant-api-gateway. The gateway's INTERNAL_API_KEY must match this value
#      or every proxied request will be rejected with 401.
#
#   B) INBOUND (caller → quant-openbb):
#      When this value is NON-EMPTY, every request to /api/v2/* must carry an
#      X-API-Key header matching this value. The check uses
#      secrets.compare_digest() for constant-time comparison (timing-attack
#      resistant). On mismatch → HTTP 401 with JSON body.
#      When this value is EMPTY (default), inbound auth is DISABLED — all
#      requests pass through without authentication.
#
#   The /health endpoint is ALWAYS open (it bypasses the auth dependency
#   because it's defined directly on the FastAPI app, not on the router).
#
# Security notes:
#   - This is a SecretStr in Pydantic, meaning it won't appear in logs or
#     repr() output. Access the raw value via .get_secret_value().
#   - In production, generate a strong random key (e.g. `openssl rand -hex 32`)
#     and set the SAME value in BOTH quant-openbb/.env and
#     quant-api-gateway/.env (as INTERNAL_API_KEY).
#   - DO NOT commit a real key to version control. .env.example should always
#     show an empty value. Real keys live in .env (gitignored).
#   - If the gateway's key and this key drift out of sync, every proxied
#     endpoint will return 401. Check the logs for "gateway returned client
#     error 401".
#
QUANT_OPENBB_INTERNAL_API_KEY=


# ─── Log Level ──────────────────────────────────────────────────────────────
#
# QUANT_OPENBB_LOG_LEVEL
#
# Controls Python's logging.basicConfig level for the openbb_quant package.
# This affects ALL loggers in the process (FastAPI/uvicorn access logs, httpx
# debug output, custom loggers in auth.py and client.py).
#
# Valid values (standard Python logging levels):
#   DEBUG   — Everything. Includes per-retry-attempt gateway call details
#             (path, params, attempt number), network error traces, and
#             auth verification results. Very verbose — use only for
#             troubleshooting proxy issues.
#   INFO    — Startup messages, health check hits, normal operational info.
#             This is the recommended default for production.
#   WARNING — Only warnings (e.g., missing X-API-Key header, auth failures)
#             and errors. Quieter but still surfaces problems.
#   ERROR   — Only error-level messages (gateway unreachable after all
#             retries, 4xx client errors). Very quiet — may hide transient
#             issues during normal operation.
#
# Note: uvicorn has its own log level (--log-level CLI flag). This setting
# controls the application-level logging, not uvicorn's access log format.
# In the Dockerfile CMD, uvicorn uses its default (info).
#
QUANT_OPENBB_LOG_LEVEL=INFO


# ─── CORS Allow Origins ─────────────────────────────────────────────────────
#
# QUANT_OPENBB_CORS_ALLOW_ORIGINS
#
# A JSON-encoded list of origins permitted to make cross-origin requests to
# quant-openbb. This is passed directly to FastAPI's CORSMiddleware as the
# allow_origins parameter.
#
# Format: JSON array of strings. Each string is an origin (scheme + host + port).
#
# Common values:
#   ["*"]                  — Allow ALL origins (wildcard). Simplest for
#                            development. When "*" is used, allow_credentials
#                            is implicitly False per the CORS spec.
#   ["http://localhost:3000", "http://localhost:8500"]
#                          — Restrict to specific origins. Use this in
#                            production when the dashboard/UI has a known URL.
#   ["http://quant-dashboard:80"]
#                          — Allow the Docker-hosted React dashboard (deprecated).
#
# This middleware is applied in main.py with:
#   allow_methods=["GET"]   — Only GET is allowed (the proxy is read-only)
#   allow_headers=["*"]     — All request headers are accepted
#
# If you're connecting from the OpenBB Dashboard or an external web app,
# add its origin here. Otherwise the browser will block cross-origin requests
# with a CORS error in the dev console.
#
# Security: never use ["*"] in production if the service is exposed beyond
# localhost. Instead, list the exact origins that need access.
#
QUANT_OPENBB_CORS_ALLOW_ORIGINS=["*"]
