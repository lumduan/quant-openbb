# quant-openbb runtime configuration. Copy to .env and fill in real values.
# .env is gitignored; only .env.example is tracked.

# Base URL of the quant-api-gateway v2 surface.
# Use the Docker hostname when running on quant-network; localhost for host-side debugging.
QUANT_OPENBB_GATEWAY_BASE_URL=http://quant-api-gateway:8000/api/v2

# Shared internal API key (must match the gateway's INTERNAL_API_KEY).
# DO NOT commit a real value — leave empty in version control.
QUANT_OPENBB_INTERNAL_API_KEY=

# Python logging level — DEBUG / INFO / WARNING / ERROR.
QUANT_OPENBB_LOG_LEVEL=INFO

# JSON-encoded CORS allow-list. ["*"] for dev; restrict in production.
QUANT_OPENBB_CORS_ALLOW_ORIGINS=["*"]
